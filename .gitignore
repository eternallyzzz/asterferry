*.exe
*.log
*.err
# Local credentials, certificates and database state must never become a
# tracked release input. Use an explicitly named, reviewed fixture directory
# for any test material that genuinely needs to be checked in.
*.key
*.crt
*.pem
# The updater's release verification key is public trust material, not a
# credential. Keep this one reviewed key in the source distribution.
!internal/update/release-public-key.pem
*.token
*.db
*.db-*
*.sqlite
*.sqlite3
secrets/
tmp/
/dist/
internal/dashboard/dist/
node_modules/
.idea/
.vscode/
/controller/
.codebuddy/

# Local test/benchmark orchestration. Keep these files available in an existing
# checkout, but do not make them part of the repository contract.
/scripts/test-all.ps1
/scripts/test-wsl.sh
/scripts/test-installers.ps1
/scripts/test-installers.sh
/scripts/test-docker.sh
/scripts/bench-cross-platform.ps1
/scripts/bench-windows.ps1
/scripts/bench-wsl.ps1
/scripts/bench-wsl.sh
/scripts/coverage.ps1
/scripts/coverage-wsl.sh
/scripts/bench-regression.sh
