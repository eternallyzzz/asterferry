[Unit]
Description=AsterFerry Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/asterferry controller run --config /var/lib/asterferry/controller.json
WorkingDirectory=/var/lib/asterferry
User=asterferry
Group=asterferry
UMask=0077
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/asterferry

[Install]
WantedBy=multi-user.target
