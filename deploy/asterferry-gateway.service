[Unit]
Description=AsterFerry Gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=asterferry
Group=asterferry
ExecStart=/usr/local/bin/asterferry gateway -c /etc/asterferry/gateway.yaml
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
