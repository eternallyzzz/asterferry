[Unit]
Description=AsterFerry Node data-plane service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/var/lib/asterferry/bin/asterferry node run --bootstrap /var/lib/asterferry/node-bootstrap.json --service-mode systemd
WorkingDirectory=/var/lib/asterferry
User=asterferry
Group=asterferry
UMask=0077
Restart=on-failure
RestartSec=2s
KillMode=process
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/asterferry

[Install]
WantedBy=multi-user.target
